# Copy to .env, or just run:  npm run setup

# SQLite database file, relative to the project root.
DATABASE_URL="file:./data/nolaptop.db"

# Encrypts SSH keys and service credentials at rest (AES-256-GCM).
# 32+ characters. Changing it makes every stored credential unreadable.
# Generate:  openssl rand -base64 48
NL_ENCRYPTION_KEY=""

# Password for the web UI. Required — NoLaptop will not serve without it.
NL_APP_PASSWORD=""

# How often servers and sessions are re-checked, in milliseconds.
NL_MONITOR_INTERVAL_MS="15000"

# Optional: override the images used for the shared services.
# NL_POSTGRES_IMAGE="postgres:18-alpine"
# NL_S3_IMAGE="chrislusf/seaweedfs:4.46"

# --- publishing (only needed for `make deploy`) ------------------------------

# The hostname you want it on. Point an A record at this machine first.
# NL_PUBLIC_HOSTNAME="nolaptop.example.com"

# How it gets TLS:
#   traefik  an existing Traefik that watches the Docker socket (default)
#   caddy    bring a Caddy along; needs ports 80 and 443 free
#   none     stay on localhost
# NL_PROXY="traefik"

# For NL_PROXY=traefik — the Docker network your Traefik is on, and its
# entrypoint and certificate resolver.
# NL_TRAEFIK_NETWORK="proxy"
# NL_TRAEFIK_ENTRYPOINT="websecure"
# NL_TRAEFIK_CERTRESOLVER="letsencrypt"

# For NL_PROXY=caddy — the address Let's Encrypt writes to.
# NL_ACME_EMAIL="you@example.com"
